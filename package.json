{
  "name": "prudence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --preserve-symlinks --preserve-symlinks-main ./node_modules/concurrently/dist/bin/concurrently.js -k -n API,WEB -c purple,blue \"python localhost/server.py\" \"node --preserve-symlinks --preserve-symlinks-main ./node_modules/vite/bin/vite.js --host 127.0.0.1\"",
    "web": "node --preserve-symlinks --preserve-symlinks-main ./node_modules/vite/bin/vite.js --host 127.0.0.1",
    "api": "python localhost/server.py",
    "build": "node --preserve-symlinks --preserve-symlinks-main ./node_modules/vite/bin/vite.js build",
    "preview": "node --preserve-symlinks --preserve-symlinks-main ./node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "serve": "node scripts/serve-dist.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "lucide-react": "^0.544.0",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  }
}
