# PRUDENCE AI Environment Variables Configuration Template
# Copy this file to .env and fill in your API credentials.

# Gemini Multimodal API Key (for vision & plan analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (for fast Llama 3.3 model plan analysis & chat)
GROQ_API_KEY=your_groq_api_key_here

# Preferred Gemini model
PRUDENCE_GEMINI_MODEL=gemini-3.1-flash-lite

# Preferred Groq model
PRUDENCE_GROQ_MODEL=openai/gpt-oss-120b

# Server configuration
PORT=5173
API_PORT=5174
