# PRUDENCE AI Environment Variables Configuration Template
# Copy this file to .env and fill in your API credentials.

# Gemini Multimodal API Key (for vision & plan analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# NVIDIA AI API Key (optional alternative LLM/vision model)
PRUDENCE_NVIDIA_API_KEY=your_nvidia_api_key_here

# Preferred Gemini model
PRUDENCE_GEMINI_MODEL=gemini-3.1-flash-lite

# Preferred NVIDIA model
PRUDENCE_NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct

# Server configuration
PORT=5173
API_PORT=5174
